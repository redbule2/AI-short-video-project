  }},

  {"跑": "btn('王家卫', '看招牌').click(); await new Promise(r => setTimeout(r, 300)); card('王家卫').querySelector('.sty-more').scrollIntoView({ block: 'center' });", "等": 700},
  {"截": "招牌", "框": {
