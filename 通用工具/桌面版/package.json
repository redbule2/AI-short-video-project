{
  "name": "antou-pipeline-desktop",
  "productName": "AI短视频流水线",
  "version": "0.1.3",
  "private": true,
  "description": "流水线桌面版：登录、窗口、更新、报错，流水线照旧由本机服务跑",
  "main": "main.js",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "start": "electron .",
    "stage": "node scripts/pack.mjs stage",
    "pack": "node scripts/pack.mjs dir",
    "dist": "node scripts/pack.mjs installer",
    "smoke": "node scripts/smoke.mjs",
    "exam": "vite build --config 考试/vite.config.mjs",
    "exam:test": "vitest run --config 考试/vite.config.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@iconify-json/ep": "1.2.4",
    "@pureadmin/utils": "2.6.2",
    "@vitejs/plugin-vue": "6.0.1",
    "@vueuse/core": "14.0.0",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "element-plus": "2.11.5",
    "pinia": "3.0.3",
    "typescript": "5.9.3",
    "unplugin-icons": "22.5.0",
    "vite": "7.1.12",
    "vitest": "4.0.8",
    "vue": "3.5.22",
    "vue-router": "4.6.3"
  }
}
